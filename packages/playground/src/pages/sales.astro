---
import { ProductMeta, SnipcartProduct } from '@lloydjatkinson/astro-snipcart';
import{ Stack, ProductGrid, ProductCard, StorePageLayout } from '@lloydjatkinson/astro-snipcart-design-system/astro';
import { headerPageLinks, footerPageLinks } from '../layouts/config';

export interface Props {
    readonly products: readonly SnipcartProduct[];
}

const products =
	(await Astro.glob<SnipcartProduct & ProductMeta>('../pages/products/*.md'))
	.map((markdownProduct) => ({ ...markdownProduct.frontmatter }));

// filter products on sale
const sales = [];
products.forEach((product) => {
    if(product.price < product.originalPrice) {
        sales.push(product);
    }
    
});

---
<StorePageLayout
    title="Products"
    description="All products available"
    headerLinks={ headerPageLinks }
    footerLinks={ footerPageLinks }
    storeName="Afrodeals"
    useDefaultLogo="hexagon"

    { ...(sales.length > 0 ? { banner: 'There are products on sale, get it now!' } : { banner: 'No products on sale for now, check back later!'}) }>
    <Stack>
        <ProductGrid>
            {
                sales.map((product) => (
                    <ProductCard
                        currency={product.currency}
                        { ...product } />
                ))
            }
        </ProductGrid>
    </Stack>
</StorePageLayout>