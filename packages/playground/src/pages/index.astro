---
import { StorePageLayout } from '@lloydjatkinson/astro-snipcart-design-system/astro';

import {
	Stack,
	Storefront,
	Text,
	Link,
} from '@lloydjatkinson/astro-snipcart-design-system/astro';
import { ProductMeta, SnipcartProduct } from '@lloydjatkinson/astro-snipcart';

import { headerPageLinks, footerPageLinks } from '../layouts/config';

const products =
	(await Astro.glob<SnipcartProduct & ProductMeta>('../pages/products/*.md'))
	.map((markdownProduct) => ({ ...markdownProduct.frontmatter }));

// sort products by cheapest first
const sortedProducts = [...products].sort((a, b) => a.price - b.price);

const welcome = "Afrodeals shopping";
---
<StorePageLayout
	title="Afrodeals @StephaneSiewe"
	description={ welcome }
	headerLinks={ headerPageLinks }
    footerLinks={ footerPageLinks }
	storeName="Afrodeals"
    useDefaultLogo="hexagon"
	image=`${import.meta.env.BASE_URL}/assets/images/t-shirts-on-hangers.jpg`
	banner={ welcome }>
	<Storefront
		title="Afrodeals"
		description="Demo store for Astro and Snipcart"
		heroHeading="Your online Afroshop"
		heroSubHeading={ welcome }
		heroImage=`${import.meta.env.BASE_URL}/assets/images/t-shirts-on-hangers.jpg`
		products={ sortedProducts }>
		<Stack
			direction="vertical"
			gap={{
				mobile: 'large'
			}}>
			<Text tone="informational">
				Lorem ipsum dolor sit amet, consetetur sadipscing elitr, sed diam nonumy eirmod tempor invidunt ut 
				labore et dolore magna aliquyam erat, sed diam voluptua. At vero eos et accusam et justo duo dolores 
				et ea rebum. Stet clita kasd gubergren, no sea takimata sanctus est Lorem ipsum dolor sit amet. Lorem 
				ipsum dolor sit amet, consetetur sadipscing elitr, sed diam nonumy eirmod tempor invidunt ut labore et 
				dolore magna aliquyam erat, sed diam voluptua. At vero eos et accusam et justo duo dolores et ea rebum. 
				Stet clita kasd gubergren, no sea takimata sanctus est Lorem ipsum dolor sit amet..
			</Text>
			<Text weight="medium">
				Lorem ipsum dolor sit amet, consetetur sadipscing elitr, sed diam nonumy eirmod tempor invidunt ut 
				labore et dolore magna aliquyam era
			</Text>
			<a decoration="underline" href="mailto:yoo-man00@hotmail.com">
			<Text
					decoration="underline">
					Made with ♥ by @Stephanesiewe
				</Text>
			</a>
		</Stack>
	</Storefront>
</StorePageLayout>