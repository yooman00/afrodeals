---
import type { SnipcartProduct, ProductMeta } from '@lloydjatkinson/astro-snipcart';
import { StorePageLayout, ProductPage } from '@lloydjatkinson/astro-snipcart-design-system/astro';

import { headerPageLinks, footerPageLinks } from './config';

type Props = SnipcartProduct & ProductMeta;
const product = Astro.props.content as Props;

const relProds = [];
const products =
	(await Astro.glob<SnipcartProduct & ProductMeta>('../pages/products/*.md'))
	.map((markdownProduct) => ({ ...markdownProduct.frontmatter }));

product.relatedProductIds.forEach((relatedProductId) => {
    const product2 = products.find((product) => product.id === relatedProductId);
    relProds.push(product2);
});

---
<StorePageLayout
    title={ product.name }
    description={ product.description }
    headerLinks={ headerPageLinks }
    footerLinks={ footerPageLinks }
    image={ product.image }
    storeName="Afrodeals"
    useDefaultLogo="hexagon"
    { ...(product.price < product.originalPrice ? { banner: 'This product is on sale, get it now!' } : {}) }>
    <ProductPage
        { ...product } relProds={ relProds }>
        <slot />
    </ProductPage>
</StorePageLayout>